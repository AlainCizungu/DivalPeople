# Build output
build/
out/
target/
dist/
.next/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Dependencies
node_modules/
.gradle/

# Environment and secrets — never commit
.env
.env.*
# Example files carry no secrets and must be committed.
!.env.example
!.env*.example

# The deployment secrets file. It is NOT called .env, so none of the patterns above catch it,
# and a file holding every production credential is the worst possible thing to find out about
# after the fact.
deploy.env
*.deploy.env
!deploy.env.example
*.pem
*.key
secrets/

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Logs and temp
*.log
npm-debug.log*
coverage/
.tmp/
*.tsbuildinfo
