# Build output
build/
out/
target/
dist/
.next/
*.class
*.jar
# Leading ** on purpose. The wrapper lives at backend/gradle/wrapper/, and a negation containing
# a slash is anchored to the directory holding the .gitignore — so "gradle/wrapper/..." only ever
# un-ignored a path at the repository root, which does not exist. The jar was therefore silently
# excluded, every clone was unbuildable, and nothing noticed until CI ran on a machine that had
# not been building here all along.
!**/gradle/wrapper/gradle-wrapper.jar

# Dependencies
node_modules/
.gradle/

# Environment and secrets — never commit
.env
.env.*
# Example files carry no secrets and must be committed.
!.env.example
!.env*.example

# The deployment secrets file. It is NOT called .env, so none of the patterns above catch it,
# and a file holding every production credential is the worst possible thing to find out about
# after the fact.
deploy.env
*.deploy.env
!deploy.env.example
*.pem
*.key
secrets/

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Logs and temp
*.log
npm-debug.log*
coverage/
.tmp/
*.tsbuildinfo

# Source data from operators. Field names and counts belong in docs/TIX_SOURCE_PROFILE.md; the
# files themselves never enter this repository — they are somebody's customer list, and git
# history is effectively permanent.
*.xlsx
*.xls
*.csv
