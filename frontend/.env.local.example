# Copy to .env.local. These are NEXT_PUBLIC_ and therefore visible in the browser bundle —
# never put a secret here.

NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8081/realms/dip
NEXT_PUBLIC_OIDC_CLIENT_ID=dip-local
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
