# Copy to .env.local.
#
# Since ADR 0003 the browser runs no part of the OIDC flow, so almost nothing here is
# NEXT_PUBLIC_ any more. These values stay on the server, which is the point: the client secret
# and the Redis address finally have somewhere safe to live.

# --- OIDC, server-side ---------------------------------------------------------------
OIDC_ISSUER=http://localhost:8081/realms/dip
OIDC_CLIENT_ID=dip-local
# Required in every deployed environment. Empty locally only while Keycloak's client is public.
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email

# --- This application ----------------------------------------------------------------
# Used to build the OIDC redirect and to refuse cross-origin calls at the proxy.
SITE_URL=http://localhost:3000

# Server-to-server. The browser never talks to the API directly.
API_BASE_URL=http://localhost:8080

# Sessions live here. High port because a locally installed Redis very commonly owns 6379.
REDIS_URL=redis://127.0.0.1:56379

# Idle timeout. Refresh happens underneath it, invisibly.
SESSION_TTL_SECONDS=43200
