# Copy to .env for local development. Never commit .env.
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-locally

DIP_DB_URL=jdbc:postgresql://localhost:5432/dip
DIP_DB_USER=dip
DIP_DB_PASSWORD=change-me-locally

REDIS_HOST=localhost
REDIS_PORT=6379

# OIDC issuer (Keycloak in local development)
DIP_OIDC_ISSUER_URI=http://localhost:8081/realms/dip
