# Copy to .env for local development. Never commit .env.
POSTGRES_DB=dip
POSTGRES_USER=dip
POSTGRES_PASSWORD=change-me-locally

DIP_DB_URL=jdbc:postgresql://127.0.0.1:55432/dip
DIP_DB_USER=dip
DIP_DB_PASSWORD=change-me-locally

REDIS_HOST=localhost
REDIS_PORT=6379

# Host ports for the local containers. Override any that clash with something
# already running on your machine.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
KEYCLOAK_HOST_PORT=8081

# OIDC issuer (Keycloak in local development)
DIP_OIDC_ISSUER_URI=http://localhost:8081/realms/dip
