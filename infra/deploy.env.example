# Copy to infra/deploy.env on the server and fill in. NEVER commit the filled-in copy.
#
#   cp infra/deploy.env.example infra/deploy.env
#   chmod 600 infra/deploy.env
#
# Every value below is required. The compose file has no defaults on purpose, so a missing one
# stops the deployment rather than quietly falling back to something from development.
#
# Generate each secret separately and do not reuse them:
#
#   openssl rand -base64 32
#
# Reusing one secret in two places means one leak is two compromises, and rotating it means two
# outages.

# --- what to deploy ----------------------------------------------------------
# The GitHub repository the images were published from, as owner/name.
#
# LOWERCASE, always, even if your repository is not. Container registries reject a mixed-case
# repository path — `AlainCizungu/DivalPeople` fails the pull with "repository name must be
# lowercase", which reads as a broken tag rather than as a capital letter. The publishing side
# lowercases it for you (docker/metadata-action does this silently), so the images really are at
# the lowercase path and this is the only place the two can disagree.
GITHUB_REPOSITORY=your-org/dip

# The commit SHA of the build you want. Use a full SHA, not `latest`.
#
# `latest` moves. A restart six weeks later silently upgrades to whatever main has become, and
# the version running is then a question nobody can answer from the server.
IMAGE_TAG=0000000000000000000000000000000000000000

# --- addresses ---------------------------------------------------------------
# Bare hostnames. Caddy obtains a certificate for each, so both must already resolve to this
# server before the first start.
SITE_HOSTNAME=dip.example.com
KEYCLOAK_HOSTNAME=id.example.com

# The full URL the browser uses. Must be https and must match SITE_HOSTNAME.
SITE_URL=https://dip.example.com

# The realm's issuer. Must be https, and must be exactly what Keycloak reports as its issuer —
# a trailing slash difference here is an afternoon of confusing 401s.
OIDC_ISSUER=https://id.example.com/realms/dip

# --- demonstration data ------------------------------------------------------
# Leave as `prod` for anything holding real records.
#
# Set to `prod,demo` on a testing instance to seed the exchange at start-up: two operators, six
# other participants, and two books of businesses aged across every band in two currencies. Every
# name carries "(demo)". Without it a fresh instance is empty, and an empty registry does not look
# new — it looks broken.
#
# It seeds DATA and never an IDENTITY. No sign-in is created by this; accounts are made by hand in
# Keycloak, and a user carrying tenant_id=11111111-1111-1111-1111-111111111111 lands in the first
# seeded book. The realm fixture in infra/keycloak/ still must never be imported: its passwords are
# published in the repository.
#
# The backend logs a warning on every start while this is on. Seeding is idempotent, so turning it
# off later leaves what was already seeded in place — that has to be cleared deliberately.
SPRING_PROFILES_ACTIVE=prod

# --- identity ----------------------------------------------------------------
OIDC_CLIENT_ID=dip-web

# The client MUST be confidential in a deployment. The frontend refuses to start without this.
OIDC_CLIENT_SECRET=

# Bootstrap administrator, used once to create the realm and then disabled. See DEPLOYMENT.md.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- letting institutions manage their own accounts --------------------------
# OFF unless you fill these in. Leave them empty and every account is created by hand on the
# server; the Access & permissions screen shows the member list and no invite form, and says why.
#
# Filled in, an institution's own TENANT_ADMIN can add and suspend their colleagues without the
# platform operator being involved. That is what this exists for: staff turnover at fifteen banks
# is not a job the network operator can hold.
#
# Generate them with:
#
#   sh infra/keycloak/setup-identity-admin.sh
#
# which creates a confidential client with a service account, grants it manage-users and
# view-users on realm-management and NOTHING else, checks that nothing else got attached, and
# writes the four values into deploy.env itself. It never prints the secret: there is no reason a
# person has to read it, and a credential on a terminal ends up in a scrollback and a screenshot.
# Leave these four empty here; the script replaces them.
#
# If the secret is ever exposed, `sh infra/keycloak/setup-identity-admin.sh rotate` replaces it and
# the old one stops working immediately.
#
# Do not shortcut it with realm-admin. These two roles let a stolen secret create a user inside a
# tenant, which is bad and bounded. realm-admin lets it rewrite the protocol mapper that puts
# tenant_id in the access token, which is the one thing every tenant boundary in DIP rests on —
# and tokens minted after that would be genuinely valid, so nothing in the application could
# notice.
#
# A DIFFERENT client from dip-web, with its own secret. Sharing one would mean a single leak costs
# both sign-in and user management.
#
# The base URL is the container name on purpose. Admin traffic stays on the private network rather
# than going out to the public hostname and back in through the proxy.
DIP_IDENTITY_ADMIN_BASE_URL=
DIP_IDENTITY_ADMIN_REALM=dip
DIP_IDENTITY_ADMIN_CLIENT_ID=
DIP_IDENTITY_ADMIN_CLIENT_SECRET=

# --- database ----------------------------------------------------------------
POSTGRES_DB=dip

# Owns the schema and runs migrations. NOT the account the application uses: the owner bypasses
# row-level security, which is the boundary between one telecom's records and another's. The
# backend refuses to start if these are the same account.
POSTGRES_OWNER_USER=dip_owner
POSTGRES_OWNER_PASSWORD=

# The application role. Its name is fixed at dip_app by the migrations; only the password is
# configurable here.
POSTGRES_APP_PASSWORD=

# Keycloak keeps its own database and its own role, so a compromise of one does not hand over
# the other.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# --- sessions ----------------------------------------------------------------
REDIS_PASSWORD=

# Twelve hours. Sessions refresh underneath this, so it is how long an unused session survives.
SESSION_TTL_SECONDS=43200

# --- uploaded files ----------------------------------------------------------
# Where employee documents and import spreadsheets land on the host.
#
# The directory must be owned by uid 10001, which is the unprivileged account the backend runs as:
#
#   sudo mkdir -p /var/lib/dip/files && sudo chown 10001:10001 /var/lib/dip/files
#
# Without that chown the application starts, reaches the file-storage bean, and exits with an
# access-denied error from a constructor — several minutes into a boot that looked healthy.
FILES_HOST_DIR=/var/lib/dip/files

# --- backups -----------------------------------------------------------------
# Where archives land on the host. A path on attached storage, or a directory something else
# syncs off the machine. NOT a directory on the same disk as the database if you can help it.
BACKUP_HOST_DIR=/var/backups/dip

# Standard five-field cron, in UTC. 02:30 daily by default.
BACKUP_CRON=30 2 * * *

# How many archives to keep. Seven daily backups is a week to notice a problem in.
BACKUP_KEEP=7

# The PUBLIC half of an age key pair. Generate it somewhere that is NOT this server:
#
#   age-keygen -o dip-backup.key
#
# Put the public line here. Keep dip-backup.key somewhere safe and off the host — a password
# manager, a hardware token, anywhere but the machine being backed up. If the private key is on
# the server then encrypting the backups protects you from nothing, because whoever takes the
# server takes both halves.
#
# Losing the private key means losing every backup. There is no recovery. Store a second copy.
BACKUP_AGE_PUBLIC_KEY=

# Set to true ONLY if the destination already encrypts at rest under a key you control. It prints
# a warning on every run, and the warning is accurate.
BACKUP_ENCRYPTION_DISABLED=false

# Set to true once something actually copies the archives off this host, to stop the reminder.
# Setting it without doing it only silences the message.
BACKUP_OFFSITE_CONFIRMED=false
