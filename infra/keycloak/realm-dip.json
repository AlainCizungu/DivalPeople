{
  "realm": "dip",
  "enabled": true,
  "displayName": "Dival Intelligence Platform (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant\",\"validations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN",
        "description": "Administers the platform itself, across all tenants"
      },
      {
        "name": "TENANT_ADMIN",
        "description": "Administers a single tenant"
      },
      {
        "name": "TIX_INQUIRER",
        "description": "May submit TIX verification inquiries"
      },
      {
        "name": "TIX_DECLARANT",
        "description": "May declare and settle TIX debt records"
      },
      {
        "name": "COMPLIANCE_OFFICER",
        "description": "Reviews alerts and audit trails"
      },
      {
        "name": "EMPLOYEE",
        "description": "Baseline self-service access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dip-local",
      "name": "DIP local development client",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "secret": "dip-local-development-secret"
    }
  ],
  "users": [
    {
      "username": "operator-a",
      "enabled": true,
      "emailVerified": true,
      "email": "operator-a@example.test",
      "firstName": "Operator",
      "lastName": "A",
      "attributes": {
        "tenant_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TIX_INQUIRER",
        "TIX_DECLARANT",
        "TENANT_ADMIN",
        "EMPLOYEE"
      ]
    },
    {
      "username": "operator-b",
      "enabled": true,
      "emailVerified": true,
      "email": "operator-b@example.test",
      "firstName": "Operator",
      "lastName": "B",
      "attributes": {
        "tenant_id": [
          "22222222-2222-2222-2222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TIX_INQUIRER",
        "TIX_DECLARANT",
        "TENANT_ADMIN",
        "EMPLOYEE"
      ]
    },
    {
      "username": "no-roles",
      "enabled": true,
      "emailVerified": true,
      "email": "no-roles@example.test",
      "firstName": "No",
      "lastName": "Roles",
      "attributes": {
        "tenant_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "EMPLOYEE"
      ]
    },
    {
      "username": "platform-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "platform-admin@example.test",
      "firstName": "Platform",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "PLATFORM_ADMIN"
      ]
    }
  ]
}
